{
    "manifest_version": 3,
    "name": "furigana_extension",
    "version": "0.1.0",
    "permissions": ["storage"],
    "action": {
        "default_popup": "popup.html"
    },
    
    "content_scripts": [
   {
     "matches": ["<all_urls>"],
     "js": ["kuromoji.js", "dist/content.js"]
   }
 ],
 "web_accessible_resources": [
    {
        "resources": ["dict/*"],
        "matches": ["<all_urls>"]
    }
 ]

}

