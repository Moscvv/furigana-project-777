{
    "manifest_version": 3,
    "name": "furigana_extension",
    "version": "0.1.0",
    "content_scripts": [
   {
     "matches": ["<all_urls>"],
     "js": ["kuromoji.js", "content.js"]
   }
 ],
 "web_accessible_resources": [
    {
        "resources": ["dict/*"],
        "matches": ["<all_urls>"]
    }
 ]
 
}

